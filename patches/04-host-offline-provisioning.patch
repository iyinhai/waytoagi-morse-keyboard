+/// 把场景文件里的简写动作统一成固件认识的形态。
+///
+/// - `"voice_ptt_hold"` → `"voice_ptt_hold"`
+/// - `"hotkey:Return"` → `{"hotkey": "Return"}`
+/// - `{"text": "【结论】"}` → 原样透传
+fn normalize_action(action: &Value) -> Result<Value, ProvisioningError> {
+    match action {
+        Value::String(text) => {
+            if let Some(hotkey) = text.strip_prefix("hotkey:") {
+                if hotkey.is_empty() {
+                    return Err(ProvisioningError::SceneFile);
+                }
+                let mut object = serde_json::Map::new();
+                object.insert("hotkey".to_string(), Value::from(hotkey));
+                Ok(Value::Object(object))
+            } else {
+                Ok(Value::String(text.clone()))
+            }
+        }
+        Value::Object(object) => {
+            if object.contains_key("hotkey") || object.contains_key("text") {
+                Ok(action.clone())
+            } else {
+                Err(ProvisioningError::SceneFile)
+            }
+        }
+        _ => Err(ProvisioningError::SceneFile),
+    }
