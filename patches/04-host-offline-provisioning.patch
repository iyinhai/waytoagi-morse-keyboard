+/// 只读监听：把板子发上来的 HID 输入报告原样打出来。
+///
+/// 用途有两个：
+/// 1. 排查「为什么下发没收到 ACK」——ACK 是一条输入报告，如果一条都读不到，
+///    说明是蓝牙 HID 的输入通道没通，而不是固件拒绝。
+/// 2. 验证键位真的生效了——按住 KEY1 应该看到空格键的键码。
+pub fn watch_inputs(seconds: u64) -> Result<Vec<String>, ProvisioningError> {
+    #[cfg(target_os = "macos")]
+    {
+        let api = hidapi::HidApi::new().map_err(|_| ProvisioningError::Hid)?;
+        api.set_open_exclusive(false);
+        let mut opened = Vec::new();
+        let mut lines = Vec::new();
+        for candidate in api.device_list() {
+            if !is_easy_input_usb_interface(
+                candidate.vendor_id(),
+                candidate.product_id(),
+                candidate.interface_number(),
+            ) {
+                continue;
+            }
+            let tag = format!(
+                "iface={} usage_page=0x{:04X} usage=0x{:04X}",
+                candidate.interface_number(),
+                candidate.usage_page(),
+                candidate.usage()
+            );
+            match candidate.open_device(&api) {
+                Ok(device) => {
+                    lines.push(format!("opened {tag}"));
+                    opened.push((tag, device));
+                }
+                // macOS 会把键盘集合当成受保护设备，非受信任进程拿不到
+                // 句柄。这里必须把失败原因打出来，否则「0 帧」到底是没发
+                // 还是没权限读，永远分不清。
+                Err(error) => lines.push(format!("open_failed {tag} err={error}")),
+            }
+        }
+        if opened.is_empty() {
+            return Err(ProvisioningError::DeviceNotFound);
+        }
+        let deadline = Instant::now() + Duration::from_secs(seconds);
+        let mut report = [0_u8; REPORT_BYTES];
+        while Instant::now() < deadline {
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            let wait_ms = remaining.as_millis().clamp(1, 200) as i32;
+            for (tag, device) in opened.iter() {
+                match device.read_timeout(&mut report, wait_ms) {
+                    Ok(0) => {}
+                    Ok(length) => {
+                        let hex = report[..length]
+                            .iter()
+                            .map(|byte| format!("{byte:02X}"))
+                            .collect::<Vec<_>>()
+                            .join(" ");
+                        lines.push(format!("{tag} len={length} [{hex}]"));
+                    }
+                    Err(error) => {
+                        lines.push(format!("{tag} read_failed err={error}"));
+                    }
+                }
+            }
+        }
+        Ok(lines)
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        let _ = seconds;
+        Err(ProvisioningError::UnsupportedPlatform)
+    }
+}
