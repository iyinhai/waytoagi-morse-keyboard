+/// 只读探测：列出当前能被下发的键盘接口（USB 与蓝牙 HID 都算）。
+/// 用来在下发前确认「板子到底在不在」，不做任何写入。
+pub fn probe_devices() -> Result<Vec<String>, ProvisioningError> {
+    #[cfg(target_os = "macos")]
+    {
+        let api = hidapi::HidApi::new().map_err(|_| ProvisioningError::Hid)?;
+        api.set_open_exclusive(false);
+        let mut found = Vec::new();
+        for device in api.device_list() {
+            // 这里刻意不按 interface 过滤：macOS 上一个复合 HID 设备会拆成
+            // 多个集合（键盘 / 鼠标 / 厂商通道），各自是独立的一条记录。
+            // 排查「按键没反应」时必须把每条都打出来，才知道键盘集合到底
+            // 有没有被系统开放给本进程。
+            if device.vendor_id() != EASY_INPUT_USB_VID
+                || device.product_id() != EASY_INPUT_USB_PID
+            {
+                continue;
+            }
+            found.push(format!(
+                "{} (VID=0x{:04X} PID=0x{:04X} iface={} usage_page=0x{:04X} usage=0x{:04X})",
+                device.product_string().unwrap_or("AI Keyboard"),
+                device.vendor_id(),
+                device.product_id(),
+                device.interface_number(),
+                device.usage_page(),
+                device.usage()
+            ));
+        }
+        Ok(found)
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        Err(ProvisioningError::UnsupportedPlatform)
+    }
+}
