+            .get("encoder")
+            .and_then(Value::as_object)
+            .ok_or(ProvisioningError::SceneFile)?;
+        let read_encoder = |field: &str| -> Result<Value, ProvisioningError> {
+            let action = encoder.get(field).ok_or(ProvisioningError::SceneFile)?;
