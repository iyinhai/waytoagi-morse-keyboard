+    /// 从场景文件加载。文件格式见 `scenes/*.json`。
+    pub fn load(path: &Path) -> Result<Self, ProvisioningError> {
+        let raw = fs::read_to_string(path).map_err(|_| ProvisioningError::SceneFile)?;
+        let doc: Value = serde_json::from_str(&raw).map_err(|_| ProvisioningError::SceneFile)?;
+        let id = doc
+            .get("id")
+            .and_then(Value::as_str)
+            .ok_or(ProvisioningError::SceneFile)?
+            .to_string();
+        let name = doc
+            .get("name")
+            .and_then(Value::as_str)
+            .unwrap_or(&id)
+            .to_string();
+        let keys_doc = doc
+            .get("keys")
+            .and_then(Value::as_object)
+            .ok_or(ProvisioningError::SceneFile)?;
+        let mut keys = Vec::with_capacity(SCENE_KEY_NAMES.len());
+        for key_name in SCENE_KEY_NAMES {
